# Copy to .env and adjust. Never commit .env (secrets stay out of git).

# PostgreSQL connection used by Prisma (apps/api) and docker-compose.yml
DATABASE_URL=postgresql://om:CHANGE_ME@localhost:5432/order_management

# NestJS API
API_PORT=3000
NODE_ENV=development

# Seed script: initial administrator (used only by `pnpm db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Web dev server: where the Vite proxy forwards /api (defaults to http://localhost:3000)
# VITE_API_PROXY_TARGET=http://localhost:3000

# Better Auth (apps/api/.env): required secret; set only in the secrets file.
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=generate-a-long-random-string
# Optional extra trusted origins (comma-separated), e.g. LAN access during dev:
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.10:5173
# Public Relay Worker sync credential (apps/relay-worker/.env):
# RELAY_MACHINE_TOKEN=generate-a-long-random-string
# SHOPIFY_WEBHOOK_SECRET=per-app-secret-from-shopify
