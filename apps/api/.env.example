# Copy to apps/api/.env and adjust. Never commit the .env file.

DATABASE_URL=postgresql://om:CHANGE_ME@localhost:5432/order_management
API_PORT=3000
NODE_ENV=development

# Better Auth (required). Generate a long random string in real use.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
# Extra origins allowed to call auth endpoints (e.g. LAN dev access):
# BETTER_AUTH_TRUSTED_ORIGINS=http://192.168.1.10:5173
# Leave unset/false for the trusted-LAN plain-HTTP posture (ADR-004):
# BETTER_AUTH_SECURE_COOKIES=true

# Seed script: initial administrator (only used by `pnpm db:seed`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Simulated platform fixtures: 'none' starts empty (demo-seed flow), default keeps demo fixtures.
SIM_ADAPTER_FIXTURES=none

# Relay Worker (real platform data). The machine token MUST match the
# worker's RELAY_MACHINE_TOKEN (apps/relay-worker/.env locally).
# RELAY_URL=http://localhost:3100
# RELAY_MACHINE_TOKEN=
