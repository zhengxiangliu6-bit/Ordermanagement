# Relay Worker environment template.
# Copy to `.env` (gitignored) for local dev; the same variable names go into
# `deploy/relay.env` on the VPS. Real secrets never enter source control.

# Shared machine credential for private-system synchronization (API <-> relay).
RELAY_MACHINE_TOKEN=replace-with-a-long-random-machine-token

# Shopify app using the Client Credentials Grant (Dev Dashboard app).
# A leaked client_secret must be treated as compromised and rotated.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Bare store hostname, never the admin.shopify.com backend URL.
SHOPIFY_SHOP_DOMAIN=attaky-dev.myshopify.com
# Pinned Admin API version used for every GraphQL call.
SHOPIFY_API_VERSION=2026-10

# Shopify webhook signing secret. Webhook intake stays disabled without it
# (webhooks also need the public VPS + TLS, configured in a later milestone).
SHOPIFY_WEBHOOK_SECRET=

# Optional overrides
# RELAY_PORT=3100
# RELAY_LEASE_TTL_SECONDS=60
